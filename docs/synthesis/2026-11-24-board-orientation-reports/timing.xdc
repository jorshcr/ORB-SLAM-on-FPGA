####################################################################################
# Constraints from file : 'orb_board.xdc'
####################################################################################

# Pin mapping and XCLK divider reused from main's Nexys A7 camera/VGA setup.
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33} [get_ports CLK100MHZ]
set_property -dict {PACKAGE_PIN C12 IOSTANDARD LVCMOS33} [get_ports CPU_RESETN]
set_property -dict {PACKAGE_PIN H16 IOSTANDARD LVCMOS33} [get_ports CAM_PCLK]
set_property -dict {PACKAGE_PIN G16 IOSTANDARD LVCMOS33} [get_ports CAM_HREF]
set_property -dict {PACKAGE_PIN G13 IOSTANDARD LVCMOS33} [get_ports CAM_VSYNC]
set_property -dict {PACKAGE_PIN F13 IOSTANDARD LVCMOS33} [get_ports CAM_RESET]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports CAM_XCLK]
set_property PACKAGE_PIN D17 [get_ports {CAM_DATA[0]}]
set_property PACKAGE_PIN C17 [get_ports {CAM_DATA[1]}]
set_property PACKAGE_PIN E17 [get_ports {CAM_DATA[2]}]
set_property PACKAGE_PIN D18 [get_ports {CAM_DATA[3]}]
set_property PACKAGE_PIN F18 [get_ports {CAM_DATA[4]}]
set_property PACKAGE_PIN E18 [get_ports {CAM_DATA[5]}]
set_property PACKAGE_PIN G18 [get_ports {CAM_DATA[6]}]
set_property PACKAGE_PIN G17 [get_ports {CAM_DATA[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {CAM_DATA[*]}]
# Timing-observation outputs on the existing segment and digit-enable pins.
set_property PACKAGE_PIN T10 [get_ports {STATUS[0]}]
set_property PACKAGE_PIN R10 [get_ports {STATUS[1]}]
set_property PACKAGE_PIN K16 [get_ports {STATUS[2]}]
set_property PACKAGE_PIN K13 [get_ports {STATUS[3]}]
set_property PACKAGE_PIN P15 [get_ports {STATUS[4]}]
set_property PACKAGE_PIN T11 [get_ports {STATUS[5]}]
set_property PACKAGE_PIN L18 [get_ports {STATUS[6]}]
set_property PACKAGE_PIN H15 [get_ports {STATUS[7]}]
set_property PACKAGE_PIN J17 [get_ports {STATUS[8]}]
set_property PACKAGE_PIN J18 [get_ports {STATUS[9]}]
set_property PACKAGE_PIN T9 [get_ports {STATUS[10]}]
set_property PACKAGE_PIN J14 [get_ports {STATUS[11]}]
set_property PACKAGE_PIN P14 [get_ports {STATUS[12]}]
set_property PACKAGE_PIN T14 [get_ports {STATUS[13]}]
set_property PACKAGE_PIN K2 [get_ports {STATUS[14]}]
set_property PACKAGE_PIN U13 [get_ports {STATUS[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {STATUS[*]}]
create_clock -period 10.000 -name sys_clk [get_ports CLK100MHZ]
create_clock -period 40.000 -name camera_pclk [get_ports CAM_PCLK]
create_generated_clock -name camera_xclk -source [get_ports CLK100MHZ] -divide_by 4 [get_pins camera_clock_buffer/O]
set_clock_groups -asynchronous -group [get_clocks {sys_clk camera_xclk}] -group [get_clocks camera_pclk]
# OV7670 Table 4: data setup 15 ns, hold 8 ns; assume +/-1 ns wiring skew.
# At 40 ns PCLK: latest transition 40-15+1=26 ns; earliest 8-1=7 ns.
set_input_delay -clock camera_pclk -max 26.000 [get_ports {CAM_DATA[*]}]
set_input_delay -clock camera_pclk -min 7.000 [get_ports {CAM_DATA[*]}]
# HREF changes 0..5 ns after falling PCLK. COM10 must retain default polarity.
set_input_delay -clock camera_pclk -clock_fall -max 6.000 [get_ports CAM_HREF]
set_input_delay -clock camera_pclk -clock_fall -min -1.000 [get_ports CAM_HREF]
# COM10[2]=0: VSYNC changes on falling PCLK; 0..5 ns delay is an assumption.
set_input_delay -clock camera_pclk -clock_fall -max 6.000 [get_ports CAM_VSYNC]
set_input_delay -clock camera_pclk -clock_fall -min -1.000 [get_ports CAM_VSYNC]
# Reset button and human-visible status have no synchronous external receiver.
set_false_path -from [get_ports CPU_RESETN]
set_false_path -to [get_ports {{STATUS[*]} CAM_RESET}]


