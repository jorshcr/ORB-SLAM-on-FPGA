# User Generated XDC timing constraints 

current_instance -quiet
create_clock -period 10.000 -name clk [get_ports clk]
create_clock -period 41.667 -name cam_pclk [get_ports cam_pclk]
set_clock_groups -asynchronous -group [get_clocks clk] -group [get_clocks cam_pclk]
set_input_delay -clock cam_pclk -max 2.000 [get_ports {{cam_data[*]} cam_href cam_vsync}]
set_input_delay -clock cam_pclk -min 0.000 [get_ports {{cam_data[*]} cam_href cam_vsync}]
set_input_delay -clock clk -max 2.000 [get_ports -filter {DIRECTION == IN && NAME != clk && NAME !~ cam_*}]
set_input_delay -clock clk -min 0.000 [get_ports -filter {DIRECTION == IN && NAME != clk && NAME !~ cam_*}]
set _xlnx_shared_i0 [all_outputs]
set_output_delay -clock clk -max 2.000 $_xlnx_shared_i0
set_output_delay -clock clk -min 0.000 $_xlnx_shared_i0

# Vivado Generated miscellaneous constraints 

#revert back to original instance
